#!/bin/bash

JOURNAL_DIR="/home/ec2-user/01linux7days-journals"
TEMP_FILE="/home/ec2-user/tmp-index.html"

cat > $TEMP_FILE << 'EOF'
<!DOCTYPE html>
<html>
<body>
    <h1>講座の学び</h1>
    <ul>
EOF

for txt_file in $JOURNAL_DIR/*.txt; do
    echo "        <li>$(basename $txt_file): $(cat $txt_file)</li>" >> $TEMP_FILE
done

cat >> $TEMP_FILE << 'EOF'
    </ul>
</body>
</html>
EOF